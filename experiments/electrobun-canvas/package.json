{
  "name": "electrobun-canvas",
  "private": true,
  "version": "0.0.1",
  "description": "Spike: Specular's spatial canvas on Electrobun — proving cross-surface (sticky/page) stacking via mask selectors, transparency, and passthrough.",
  "type": "module",
  "scripts": {
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "start": "vite build && electrobun dev",
    "build:canary": "vite build && electrobun build --env=canary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electrobun": "1.18.4-beta.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
