{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specular-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CANVAS_DOC",
        "class_name": "CanvasDoc"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanvasDoc"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "specular-auth",
      "database_id": "c0c4787e-516e-4b12-bd77-9e41cc57567e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "specular-assets"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"
  }
}
