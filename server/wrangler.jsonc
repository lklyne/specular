{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specular-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  // The web viewer (`web/`, with `web/pkg` built by `web/build.sh`). The
  // worker runs first so the API, `/assets/:hash` and `/c/:docId` stay its
  // own; it hands every other GET to these files.
  "assets": {
    "directory": "../web",
    "binding": "WEB",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "specular-auth",
      "database_id": "c0c4787e-516e-4b12-bd77-9e41cc57567e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "specular-assets"
    }
  ],
  // One live room per shared canvas: its yrs updates, relayed and kept.
  "durable_objects": {
    "bindings": [{ "name": "LIVE_ROOM", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "vars": {
    "BETTER_AUTH_URL": "https://specular-server.lyle-klyne.workers.dev"
  }
}
