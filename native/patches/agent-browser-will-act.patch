diff --git a/cli/src/native/pre_act.rs b/cli/src/native/pre_act.rs
new file mode 100644
index 0000000..d5bbaed
--- /dev/null
+++ b/cli/src/native/pre_act.rs
@@ -0,0 +1,167 @@
+//! Pre-act hook for hosts that proxy CDP (Specular).
+//!
+//! Before a targeted action dispatches input, send the browser-level command
+//! `Specular.willAct` with the element centre and wait for any reply, so the
+//! host can animate a cursor to the target first. Plain Chrome rejects the
+//! method; that is remembered and the hook is never sent again.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+use std::time::Duration;
+
+use serde_json::json;
+
+use super::cdp::client::CdpClient;
+use super::element::{resolve_element_center, session_viewport_offset, RefMap};
+
+static DISABLED: AtomicBool = AtomicBool::new(false);
+static SESSION: OnceLock<String> = OnceLock::new();
+
+/// Records the daemon's session name for the hook payload.
+pub fn set_session(session: &str) {
+    let _ = SESSION.set(session.to_string());
+}
+
+/// Announces `action` on `selector_or_ref` and waits for the host's go-ahead
+/// (`wait: true`: the host may hold the reply while its cursor travels).
+/// Never fails: any problem computing the centre or sending just skips the hook.
+pub async fn pre_act(
+    client: &CdpClient,
+    session_id: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+    action: &str,
+) {
+    announce_element(
+        client,
+        session_id,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+        action,
+        true,
+    )
+    .await;
+}
+
+/// Like `pre_act` for reads and inspections (`wait: false`): the host moves its
+/// cursor but answers immediately.
+pub async fn pre_look(
+    client: &CdpClient,
+    session_id: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+    action: &str,
+) {
+    announce_element(
+        client,
+        session_id,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+        action,
+        false,
+    )
+    .await;
+}
+
+/// Announces a keyboard action at the centre of the focused element; skipped
+/// when nothing but the body has focus.
+pub async fn pre_type(client: &CdpClient, session_id: &str, action: &str) {
+    if DISABLED.load(Ordering::Relaxed) {
+        return;
+    }
+    const ACTIVE_CENTER: &str = "(() => { const e = document.activeElement; \
+        if (!e || e === document.body || e === document.documentElement) return null; \
+        const r = e.getBoundingClientRect(); \
+        if (!r.width || !r.height) return null; \
+        return [r.x + r.width / 2, r.y + r.height / 2]; })()";
+    let Ok(result) = client
+        .send_command(
+            "Runtime.evaluate",
+            Some(json!({ "expression": ACTIVE_CENTER, "returnByValue": true })),
+            Some(session_id),
+        )
+        .await
+    else {
+        return;
+    };
+    let centre = result.pointer("/result/value").and_then(|v| v.as_array());
+    if let Some([x, y]) = centre.map(Vec::as_slice) {
+        if let (Some(x), Some(y)) = (x.as_f64(), y.as_f64()) {
+            send(client, session_id, action, x, y, true).await;
+        }
+    }
+}
+
+async fn announce_element(
+    client: &CdpClient,
+    session_id: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+    action: &str,
+    wait: bool,
+) {
+    if DISABLED.load(Ordering::Relaxed) {
+        return;
+    }
+    let Ok((x, y, target_session)) = resolve_element_center(
+        client,
+        session_id,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+    )
+    .await
+    else {
+        return;
+    };
+    let Ok(offset) =
+        session_viewport_offset(client, session_id, &target_session, iframe_sessions).await
+    else {
+        return;
+    };
+    send(client, session_id, action, x + offset.0, y + offset.1, wait).await;
+}
+
+/// The top-level page's scroll offset, so the host can keep its cursor on the
+/// element when the page scrolls later.
+async fn page_scroll(client: &CdpClient, session_id: &str) -> Option<(f64, f64)> {
+    let result = client
+        .send_command(
+            "Runtime.evaluate",
+            Some(json!({ "expression": "[scrollX, scrollY]", "returnByValue": true })),
+            Some(session_id),
+        )
+        .await
+        .ok()?;
+    let value = result.pointer("/result/value")?.as_array()?;
+    Some((value.first()?.as_f64()?, value.get(1)?.as_f64()?))
+}
+
+async fn send(client: &CdpClient, session_id: &str, action: &str, x: f64, y: f64, wait: bool) {
+    let mut params = json!({
+        "action": action,
+        "x": x,
+        "y": y,
+        "wait": wait,
+        "session": SESSION.get().map(String::as_str).unwrap_or(""),
+    });
+    if let Some((scroll_x, scroll_y)) = page_scroll(client, session_id).await {
+        params["scrollX"] = json!(scroll_x);
+        params["scrollY"] = json!(scroll_y);
+    }
+    let reply = tokio::time::timeout(
+        Duration::from_secs(3),
+        client.send_command("Specular.willAct", Some(params), None),
+    )
+    .await;
+    // A timeout means "go"; a CDP error means the host does not speak the hook.
+    if let Ok(Err(_)) = reply {
+        DISABLED.store(true, Ordering::Relaxed);
+    }
+}
