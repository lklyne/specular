diff --git a/cli/src/native/pre_act.rs b/cli/src/native/pre_act.rs
new file mode 100644
index 0000000..0639fa4
--- /dev/null
+++ b/cli/src/native/pre_act.rs
@@ -0,0 +1,70 @@
+//! Pre-act hook for hosts that proxy CDP (Specular).
+//!
+//! Before a targeted action dispatches input, send the browser-level command
+//! `Specular.willAct` with the element centre and wait for any reply, so the
+//! host can animate a cursor to the target first. Plain Chrome rejects the
+//! method; that is remembered and the hook is never sent again.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+use std::time::Duration;
+
+use serde_json::json;
+
+use super::cdp::client::CdpClient;
+use super::element::{resolve_element_center, session_viewport_offset, RefMap};
+
+static DISABLED: AtomicBool = AtomicBool::new(false);
+static SESSION: OnceLock<String> = OnceLock::new();
+
+/// Records the daemon's session name for the hook payload.
+pub fn set_session(session: &str) {
+    let _ = SESSION.set(session.to_string());
+}
+
+/// Announces `action` on `selector_or_ref` to the host and waits for its go-ahead.
+/// Never fails: any problem computing the centre or sending just skips the hook.
+pub async fn pre_act(
+    client: &CdpClient,
+    session_id: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+    action: &str,
+) {
+    if DISABLED.load(Ordering::Relaxed) {
+        return;
+    }
+    let Ok((x, y, target_session)) = resolve_element_center(
+        client,
+        session_id,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+    )
+    .await
+    else {
+        return;
+    };
+    let Ok(offset) =
+        session_viewport_offset(client, session_id, &target_session, iframe_sessions).await
+    else {
+        return;
+    };
+    let params = json!({
+        "action": action,
+        "x": x + offset.0,
+        "y": y + offset.1,
+        "session": SESSION.get().map(String::as_str).unwrap_or(""),
+    });
+    let reply = tokio::time::timeout(
+        Duration::from_secs(3),
+        client.send_command("Specular.willAct", Some(params), None),
+    )
+    .await;
+    // A timeout means "go"; a CDP error means the host does not speak the hook.
+    if let Ok(Err(_)) = reply {
+        DISABLED.store(true, Ordering::Relaxed);
+    }
+}
