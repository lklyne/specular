{
  "title": "Side-by-side chats",
  "id": "root",
  "type": "column",
  "share": { "mod": "share" },
  "toast": { "mod": "toast" },
  "children": [
    { "id": "tabs", "type": "block", "size": { "px": 38 }, "background": "toolbar", "content": { "mod": "tabs" } },
    {
      "id": "body",
      "type": "row",
      "children": [
        { "id": "toolbar", "type": "block", "size": { "px": 36 }, "content": { "mod": "toolbar" } },
        { "id": "canvas", "type": "block", "content": "canvas" },
        {
          "id": "chats",
          "type": "row",
          "size": { "px": 760 },
          "children": [
            { "id": "chat.a", "type": "block", "content": { "mod": "chat", "props": { "pane": "a" } } },
            { "id": "chat.b", "type": "block", "content": { "mod": "chat", "props": { "pane": "b" } } }
          ]
        }
      ]
    }
  ]
}
